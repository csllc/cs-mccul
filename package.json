{
  "name": "cs-mccul",
  "version": "0.0.1",
  "description": "MCC Universal Library module for NodeJS",
  "main": "index.js",
  "scripts": {
    "install": "node-pre-gyp install --fallback-to-build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Calvin Walden <cwalden@controls.com>",
  "license": "MIT",
  "dependencies": {
    "bindings": "~1.2.1",
    "eslint": "^7.10.0",
    "node-gyp": "^7.1.1",
    "node-pre-gyp": "^0.15.0",
    "stream": "0.0.2"
  },
  "binary": {
    "module_name": "cs_mccul",
    "package_name": "{module_name}-v{version}-{node_abi}-{platform}-{arch}.tar.gz",
    "module_path": "./binding/{configuration}/{node_abi}-{platform}-{arch}/",
    "host": "https://github.com/csllc/cs-mccul-binding/releases/download/",
    "remote_path": "{version}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csllc/cs-mccul.git"
  },
  "gypfile": true,
  "devDependencies": {
    "node-api-headers": "^1.9.0"
  }
}
