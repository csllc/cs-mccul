{
  "name": "@csllc/cs-mccul",
  "version": "0.0.1",
  "description": "MCC Universal Library module for NodeJS",
  "main": "index.js",
  "files": [
    "index.js",
    "lib/",
    "src/",
    "tools/",
    "binding.gyp",
    "prebuilds/",
    "vendor/uldaq/src/",
    "vendor/uldaq/rules/",
    "vendor/uldaq/LICENSE"
  ],
  "scripts": {
    "install": "node-gyp-build",
    "build": "node-gyp build",
    "rebuild": "node-gyp rebuild",
    "prebuildify:x64": "prebuildify --napi --strip --arch x64",
    "prebuildify:arm64": "CC=aarch64-linux-gnu-gcc CXX=aarch64-linux-gnu-g++ LINK=aarch64-linux-gnu-g++ AR=aarch64-linux-gnu-ar prebuildify --napi --arch arm64",
    "prebuildify": "npm run prebuildify:x64 && npm run prebuildify:arm64",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Calvin Walden <cwalden@controls.com>",
  "license": "MIT",
  "dependencies": {
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "eslint": "^7.10.0",
    "node-api-headers": "^1.9.0",
    "node-gyp": "^11.0.0",
    "prebuildify": "^6.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/csllc/cs-mccul.git"
  },
  "gypfile": true,
  "publishConfig": { "access": "public" }
}
